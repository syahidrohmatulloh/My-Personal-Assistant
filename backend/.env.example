# Anthropic — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI — embeddings for cross-conversation memory.
# Get from https://dash.voyageai.com → API keys → Create new secret key.
VOYAGE_API_KEY=pa-...

# Supabase — get from your project's Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Settings → API → JWT Secret. KEEP THIS SECRET.
SUPABASE_JWT_SECRET=your-jwt-secret-here

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Model to use. claude-sonnet-4-6 is a strong default; switch to claude-opus-4-7
# for harder tasks or claude-haiku-4-5 for cheaper/faster ones.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Supabase JWT verification
SUPABASE_JWT_AUDIENCE=authenticated

# --- Dual LLM Provider Architecture ---
# Chat stays on Claude by default. Do not switch chat provider until pilots are stable.
CHAT_LLM_PROVIDER=claude

# Utility provider for future low-risk tasks: summaries, titles, classification.
UTILITY_LLM_PROVIDER=claude
UTILITY_LLM_MODEL=claude-haiku-4-5

# Ollama / self-hosted model settings for future utility pilots.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

